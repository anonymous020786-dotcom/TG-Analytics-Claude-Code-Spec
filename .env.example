# TG Analytics — example configuration for LOCAL development only.
# Copy to .env (git-ignored) and adjust. Never put real secrets in this file.
#
# Staging/production: inject variables from the secret store, never from .env files.
# Any secret may instead be supplied as <NAME>_FILE=/path/to/file (Docker/K8s secrets).
# Reference: docs/operations/CONFIGURATION.md

# Deployment environment: local | development | staging | production
APP_ENV=local

# --- apps/api ---
# HTTP port (1-65535)
PORT=3001
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL (packages/database, docker-compose) ---
# Secrets: choose your own local values. Never commit them.
# Local compose superuser password for the postgres service.
POSTGRES_PASSWORD=
# postgresql://tga:<POSTGRES_PASSWORD>@127.0.0.1:5432/tga
DATABASE_URL=
# Prisma shadow database for `migrate dev` / drift checks: .../tga_shadow
SHADOW_DATABASE_URL=
# Integration tests: database name MUST end with _test (it is wiped): .../tga_test
TEST_DATABASE_URL=

# --- Redis (queue transport, docker-compose) ---
# Secrets: choose your own local values. Never commit them.
REDIS_PASSWORD=
# redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_URL=
# Integration tests (queues use a unique key prefix per run): redis://:<REDIS_PASSWORD>@127.0.0.1:6379/15
TEST_REDIS_URL=

# --- workers/* (channel.discovery, channel.metadata, channel.metrics) ---
# Also use DATABASE_URL, REDIS_URL, LOG_LEVEL and APP_ENV above.
QUEUE_PREFIX=tga
# Jobs processed in parallel per worker process (1-16)
WORKER_CONCURRENCY=2
# Telegram bot token from @BotFather (secret; dedicated to this project, D-015)
TELEGRAM_BOT_TOKEN=
# Non-secret label for the credential (rate-limit keys, logs)
TELEGRAM_CREDENTIAL_ID=bot-1

# --- workers/scheduler ---
# Seconds between scheduler ticks (10-3600)
SCHEDULER_TICK_SECONDS=60
# Refresh intervals, provisional until freshness targets are set (OD-005)
METRICS_REFRESH_MINUTES=360
METADATA_REFRESH_MINUTES=1440
RANKING_REFRESH_MINUTES=60

# --- apps/api: indexation rule (PHASE-14), provisional until OD-008 ---
# A channel page is indexable only with at least this many subscribers ...
SEO_MIN_MEMBERS=1000
# ... and at least this many days of collected history
SEO_MIN_HISTORY_DAYS=7

# --- apps/api: Sign in with Telegram (PHASE-16, D-021) ---
# Login bot token (secret; its domain must be set in BotFather with /setdomain). Leave empty to disable sign-in.
TELEGRAM_LOGIN_BOT_TOKEN=
# Login bot username (public), e.g. tga_login_bot
TELEGRAM_LOGIN_BOT_USERNAME=
# HMAC secret for CSRF tokens (secret, >= 32 characters)
CSRF_SECRET=
# Session lifetimes in days, provisional (OD-005)
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_DAYS=7
# Secure __Host- cookies; set false only for plain-HTTP testing on a non-localhost host
COOKIE_SECURE=true

# --- apps/web (server-side only) ---
# Base URL of the API as seen from the web server (never sent to browsers)
API_INTERNAL_URL=http://127.0.0.1:3001
# Public origin used for canonical URLs, sitemap and Open Graph (no trailing slash)
PUBLIC_SITE_URL=http://127.0.0.1:3000
