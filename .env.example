# TG Analytics — example configuration for LOCAL development only.
# Copy to .env (git-ignored) and adjust. Never put real secrets in this file.
#
# Staging/production: inject variables from the secret store, never from .env files.
# Any secret may instead be supplied as <NAME>_FILE=/path/to/file (Docker/K8s secrets).
# Reference: docs/operations/CONFIGURATION.md

# Deployment environment: local | development | staging | production
APP_ENV=local

# --- apps/api ---
# HTTP port (1-65535)
PORT=3001
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- PostgreSQL (packages/database, docker-compose) ---
# Secrets: choose your own local values. Never commit them.
# Local compose superuser password for the postgres service.
POSTGRES_PASSWORD=
# postgresql://tga:<POSTGRES_PASSWORD>@127.0.0.1:5432/tga
DATABASE_URL=
# Prisma shadow database for `migrate dev` / drift checks: .../tga_shadow
SHADOW_DATABASE_URL=
# Integration tests: database name MUST end with _test (it is wiped): .../tga_test
TEST_DATABASE_URL=

# --- Redis (queue transport, docker-compose) ---
# Secrets: choose your own local values. Never commit them.
REDIS_PASSWORD=
# redis://:<REDIS_PASSWORD>@127.0.0.1:6379/0
REDIS_URL=
# Integration tests (queues use a unique key prefix per run): redis://:<REDIS_PASSWORD>@127.0.0.1:6379/15
TEST_REDIS_URL=

# --- workers/* (channel.discovery, channel.metadata, channel.metrics) ---
# Also use DATABASE_URL, REDIS_URL, LOG_LEVEL and APP_ENV above.
QUEUE_PREFIX=tga
# Jobs processed in parallel per worker process (1-16)
WORKER_CONCURRENCY=2
# Telegram bot token from @BotFather (secret; dedicated to this project, D-015)
TELEGRAM_BOT_TOKEN=
# Non-secret label for the credential (rate-limit keys, logs)
TELEGRAM_CREDENTIAL_ID=bot-1
